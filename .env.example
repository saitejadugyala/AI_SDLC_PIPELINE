# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored. Never put real keys in THIS file (.env.example is committed).

# ============================================================
# Required for the web app to start
# ============================================================
# At least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# ============================================================
# GitHub OAuth (login, repo picker, deploy)
# ============================================================
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Homepage URL:               http://localhost:8000
#   Authorization callback URL: http://localhost:8000/auth/github/callback
# Without these the app still starts, but login returns 503.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Must match the OAuth app's URLs. Use https://... in production (enables Secure cookies).
APP_BASE_URL=http://localhost:8000
# Only change for GitHub Enterprise.
GITHUB_API_URL=https://api.github.com

# ============================================================
# LLM providers: set at least one key
# ============================================================
# Providers are tried in this order; any provider without a key is skipped.
# If one fails (bad key, outage, repeated invalid output), the next one is used.
LLM_PROVIDER_ORDER=gemini,openai,openrouter
LLM_MAX_ATTEMPTS_PER_PROVIDER=3
LLM_TIMEOUT_SECONDS=90

# Google Gemini: https://aistudio.google.com/apikey
# Also used for RAG embeddings (embeddings have no fallback provider).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# OpenAI: https://platform.openai.com/api-keys
# Check that OPENAI_MODEL is a model your account can use and that it supports
# structured outputs (response_format=json_schema).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-small

# RAG ("Ask about a repo") embeddings: auto = Gemini if GEMINI_API_KEY is set, else OpenAI.
# Changing provider/model means repos must be re-ingested (old vectors aren't comparable).
EMBEDDING_PROVIDER=auto

# OpenRouter: https://openrouter.ai/keys  (reports real per-call cost)
# openrouter/auto lets OpenRouter pick a model; set a specific one for repeatable results.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================================
# Observability: LangSmith (optional)
# ============================================================
# https://smith.langchain.com -> Settings -> API Keys
# When enabled, every pipeline run is traced: LangGraph steps plus each LLM call
# with prompts, outputs, tokens, cost and the run's thread_id.
# Prompts include your requests and repository code. To keep them out of
# LangSmith, also set LANGSMITH_HIDE_INPUTS and LANGSMITH_HIDE_OUTPUTS to true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-sdlc-pipeline
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============================================================
# Pipeline
# ============================================================
# Automatic Coding<->QA retries before a human sees a failing QA.
MAX_QA_RETRIES=3
# Defaults to <repo>/mcp_server/github_mcp_server.py
# MCP_SERVER_PATH=

# ============================================================
# Uploads (bytes)
# ============================================================
# MAX_UPLOAD_BYTES=20971520          # 20 MB compressed zip
# MAX_UNCOMPRESSED_BYTES=104857600   # 100 MB once extracted (zip-bomb guard)
# MAX_ZIP_ENTRIES=5000

# ============================================================
# Storage (relative paths are resolved against the repo root)
# ============================================================
# APP_DB_PATH=app.db
# CHECKPOINT_DB_PATH=checkpoints.db
# OUTPUT_DIR=outputs
